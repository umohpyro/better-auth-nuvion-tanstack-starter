BETTER_AUTH_SECRET=change-me-to-a-long-random-string
BETTER_AUTH_URL=http://localhost:3000
# Nuvion test environment: https://api.nuvion.dev   Production: https://api.nuvion.co
NUVION_BASE_URL=https://api.nuvion.dev
NUVION_API_KEY=
# The webhook signing secret (nv_wsk_...). Point the webhook at https://<your-https-host>/api/auth/nuvion/webhook
NUVION_WEBHOOK_SECRET=
# Postgres. Leave unset to use a local SQLite file (dev.db).
# DATABASE_URL=postgres://...
# Optional: prefill the connect form (for a hosted demo)
# VITE_DEMO_ENTITY_ID=
# VITE_DEMO_ACCOUNT_ID=
